# Copy to .env for local work. On Railway these are service variables — never
# commit real values. Everything marked NEEDED blocks go-live.

# ── Railway Postgres ────────────────────────────────────────────────────────
# NOTE THE DATABASE NAME: customer360, not railway.
#
# n8n stores its own 114 tables in railway/public — including one called
# `agents`, which collides head-on with ours. Customer 360 therefore lives in a
# separate database on the same Postgres instance: same server, same backups,
# zero chance of a name collision, and either side can be dropped and rebuilt
# without touching the other.
#
# Use the PRIVATE host from inside Railway — it skips the public internet and is
# not billed as egress. The sakura.proxy.rlwy.net:PORT public URL is for running
# migrations from a laptop, and public networking should be turned back off on
# the Postgres service once you are done with it.
DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/customer360

# ── Worker auth ─────────────────────────────────────────────────────────────
# Shared secret between n8n and the worker. Generate: openssl rand -hex 32
WORKER_API_KEY=
WORKER_URL=http://worker.railway.internal:8000

# ── DeepSeek — the rubric judge ─────────────────────────────────────────  NEEDED
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── Chats source — Bitrix24 ─────────────────────────────────────────────  NEEDED
# The live portal. `cultiv.bitrix24.com` sat here for months and was stale.
BITRIX_PORTAL_DOMAIN=travelgate.bitrix24.ae
BITRIX_WEBHOOK_TOKEN=
# Optional shared secret the webhook must present, so the endpoint is not open.
BITRIX_WEBHOOK_SECRET=

# ── Calls ───────────────────────────────────────────────────────────────────
# There is no calls lane. It was removed on 2026-09-14 — not for cost and not
# for volume, but because every recording decoded to extension 3009, a QUEUE,
# so no call could ever be attributed to a salesperson. The code, the schema
# and the data are in ../travelgate-calls-archive/, and it comes back when the
# PBX records the answering extension. ASR_BACKEND, COHERE_API_KEY,
# DRIVE_CALLS_FOLDER_ID, GOOGLE_SERVICE_ACCOUNT_JSON and PBX_TZ_OFFSET_HOURS
# went with it: the worker no longer reads any of them.

# ── Regional ────────────────────────────────────────────────────────────
# DECIDED 2026-07-29: Saudi Arabia — "95% of phones are Saudi".
# This only applies to numbers arriving in NATIONAL format (0500000000). Any
# number that already carries a country code is honoured as-is, so the Egyptian
# minority still resolves correctly as long as it arrives as +20… or 0020…
#
# The ~5% that arrive Egyptian in bare national format WILL fail to normalise
# rather than being silently mis-assigned to +966. That is deliberate: those
# rows land with phone_error set and no customer link, which is recoverable.
# A silent wrong-country match is not — it merges two real people.
# Watch: SELECT count(*) FROM interactions WHERE customer_phone_e164 IS NULL
#        AND customer_phone_raw IS NOT NULL;
DEFAULT_PHONE_REGION=SA

# ── Pipeline behaviour ──────────────────────────────────────────────────────
# Wait for a thread to go quiet before spending a model call on it.
REANALYSIS_IDLE_MINUTES=30
# Bot-only threads are excluded from agent scoring by default, and should stay
# that way: grading humans on the qualification bot's messages corrupts every
# QA number.
SCORE_BOT_ONLY_CONVERSATIONS=false
WORK_DIR=/tmp/customer360
LOG_LEVEL=INFO
